{{- if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'
$env:DOTFILES_INSTALL_GROK = '{{ if index . "installGrok" }}true{{ else }}false{{ end }}'
$env:DOTFILES_INSTALL_CODEX = '{{ if index . "installCodex" }}true{{ else }}false{{ end }}'
$env:DOTFILES_INSTALL_CLAUDE = '{{ if index . "installClaudeCode" }}true{{ else }}false{{ end }}'
& '{{ joinPath .chezmoi.workingTree "scripts/setup.ps1" | replace "'" "''" }}'
{{- end -}}
