// LazyVim-style keybindings for VS Code (managed with the Vim extension)
[
    {"key": "ctrl+/", "command": "workbench.action.terminal.toggleTerminal", "when": "(editorTextFocus && vim.active && vim.mode != 'Insert') || terminalFocus"},
    {"key": "ctrl+h", "command": "workbench.action.navigateLeft", "when": "terminalFocus"},
    {"key": "ctrl+j", "command": "workbench.action.navigateDown", "when": "terminalFocus"},
    {"key": "ctrl+k", "command": "workbench.action.navigateUp", "when": "terminalFocus"},
    {"key": "ctrl+l", "command": "workbench.action.navigateRight", "when": "terminalFocus"},
    {"key": "ctrl+up", "command": "workbench.action.increaseViewSize", "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"},
    {"key": "ctrl+down", "command": "workbench.action.decreaseViewSize", "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"},
    {"key": "ctrl+right", "command": "workbench.action.increaseViewSize", "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"},
    {"key": "ctrl+left", "command": "workbench.action.decreaseViewSize", "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"},
    {"key": "ctrl+j", "command": "selectNextSuggestion", "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"},
    {"key": "ctrl+k", "command": "selectPrevSuggestion", "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"},
    {"key": "ctrl+n", "command": "selectNextSuggestion", "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"},
    {"key": "ctrl+p", "command": "selectPrevSuggestion", "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"},
    {"key": "j", "command": "list.focusDown", "when": "listFocus && !inputFocus && !treeFindOpen"},
    {"key": "k", "command": "list.focusUp", "when": "listFocus && !inputFocus && !treeFindOpen"},
    {"key": "g g", "command": "list.focusFirst", "when": "listFocus && !inputFocus && !treeFindOpen"},
    {"key": "shift+g", "command": "list.focusLast", "when": "listFocus && !inputFocus && !treeFindOpen"},
    {"key": "l", "command": "list.select", "when": "listFocus && !inputFocus && !treeFindOpen"},
    {"key": "h", "command": "list.collapse", "when": "listFocus && !inputFocus && !treeFindOpen"},
    {"key": "a", "command": "explorer.newFile", "when": "filesExplorerFocus && !inputFocus && !treeFindOpen"},
    {"key": "shift+a", "command": "explorer.newFolder", "when": "filesExplorerFocus && !inputFocus && !treeFindOpen"},
    {"key": "d", "command": "deleteFile", "when": "filesExplorerFocus && !inputFocus && !treeFindOpen"},
    {"key": "r", "command": "renameFile", "when": "filesExplorerFocus && !inputFocus && !treeFindOpen"},
    {"key": "y", "command": "filesExplorer.copy", "when": "filesExplorerFocus && !inputFocus && !treeFindOpen"},
    {"key": "x", "command": "filesExplorer.cut", "when": "filesExplorerFocus && !inputFocus && !treeFindOpen"},
    {"key": "p", "command": "filesExplorer.paste", "when": "filesExplorerFocus && !inputFocus && !treeFindOpen"},
    {"key": "q", "command": "workbench.action.closeSidebar", "when": "filesExplorerFocus && !inputFocus && !treeFindOpen"},
    {"key": "v", "command": "explorer.openToSide", "when": "filesExplorerFocus && !inputFocus && !treeFindOpen"},
    {"key": "shift+r", "command": "workbench.files.action.refreshFilesExplorer", "when": "filesExplorerFocus && !inputFocus && !treeFindOpen"},
    {"key": "ctrl+j", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen"},
    {"key": "ctrl+k", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen"},
    {"key": "ctrl+n", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen"},
    {"key": "ctrl+p", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen"},
    {"key": "alt+n", "command": "editor.action.wordHighlight.next", "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"},
    {"key": "alt+p", "command": "editor.action.wordHighlight.prev", "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"},
    {"key": "escape", "command": "workbench.action.focusActiveEditorGroup", "when": "sideBarFocus && !inputFocus && !treeFindOpen"}
]
