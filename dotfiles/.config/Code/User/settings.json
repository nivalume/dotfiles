  "vim.normalModeKeyBindings": [
      // ----- Surround / comment -----
      {"before": ["g", "s", "a"], "after": ["y", "s"]},
      {"before": ["g", "s", "d"], "after": ["d", "s"]},
      {"before": ["g", "s", "r"], "after": ["c", "s"]},
      {"before": ["g", "c", "o"], "after": ["o", "<Esc>", "g", "c", "c", "A"]},
      {"before": ["g", "c", "O"], "after": ["O", "<Esc>", "g", "c", "c", "A"]},
  ],

  "vim.visualModeKeyBindingsNonRecursive": [
      // ----- Core -----
      {"before": ["<A-j>"], "commands": ["editor.action.moveLinesDownAction"]},
      {"before": ["<A-k>"], "commands": ["editor.action.moveLinesUpAction"]},
      {"before": ["j"], "after": ["g", "j"]},
      {"before": ["k"], "after": ["g", "k"]},
      {"before": [">"], "after": [">", "g", "v"]},
      {"before": ["<"], "after": ["<", "g", "v"]},
      {"before": ["<C-space>"], "commands": ["editor.action.smartSelect.expand"]},
      {"before": ["<BS>"], "commands": ["editor.action.smartSelect.shrink"]},
      {"before": ["a", "g"], "after": ["g", "g", "V", "G"]},
      {"before": ["i", "g"], "after": ["g", "g", "V", "G"]},
      // ----- Search -----
      {"before": ["<leader>", "s", "r"], "commands": ["workbench.action.replaceInFiles"]},
      {"before": ["<leader>", "s", "w"], "commands": ["workbench.action.findInFiles"]},
      {"before": ["<leader>", "s", "W"], "commands": ["workbench.action.findInFiles"]},
      // ----- Code / LSP -----
      {"before": ["<leader>", "c", "a"], "commands": ["editor.action.quickFix"]},
