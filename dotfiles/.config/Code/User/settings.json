{
  "editor.lineNumbers": "relative",
  "editor.cursorSurroundingLines": 4,
  "editor.cursorSurroundingLinesStyle": "all",
  "editor.formatOnSave": true,
  "editor.stickyScroll.enabled": true,
  "editor.scrollBeyondLastLine": false,
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "search.seedWithNearestWord": true,
  "workbench.list.automaticKeyboardNavigation": false,
  "terminal.integrated.commandsToSkipShell": ["workbench.action.navigateLeft","workbench.action.navigateRight","workbench.action.navigateUp","workbench.action.navigateDown","workbench.action.terminal.toggleTerminal"],
  "[python]": {
    "editor.formatOnType": true
  },
  "explorer.confirmDelete": false,

  "accessibility.signals.lineHasInlineSuggestion": {
    "sound": "off"
  },

// ================= Vim (LazyVim-style mappings, leader = Space) =================
  "vim.leader": "<space>",
  "vim.useCtrlKeys": true,
  "vim.handleKeys": {
    "<C-a>": false, "<C-c>": false, "<C-x>": false, "<C-f>": false, "<C-n>": false,
    "<C-p>": false, "<C-b>": false, "<C-e>": false, "<C-z>": false, "<C-y>": false
  },
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.ignorecase": true,
  "vim.smartcase": true,
  "vim.useSystemClipboard": true,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 200,
  "vim.surround": true,
  "vim.targets.enable": true,
  "vim.timeout": 400,
  "vim.vimrc.enable": false,
  "vim.cursorStylePerMode.normal": "block",
  "vim.cursorStylePerMode.insert": "line",
  "vim.cursorStylePerMode.visual": "block",
  "vim.cursorStylePerMode.replace": "underline",

  "vim.normalModeKeyBindingsNonRecursive": [
      // ----- Core -----
      {"before": ["<Esc>"], "commands": [":nohl"]},
      {"before": ["<A-j>"], "commands": ["editor.action.moveLinesDownAction"]},
      {"before": ["<A-k>"], "commands": ["editor.action.moveLinesUpAction"]},
      {"before": ["j"], "after": ["g", "j"]},
      {"before": ["k"], "after": ["g", "k"]},
      {"before": ["<leader>", "l"], "commands": ["workbench.view.extensions"]},
      {"before": ["<leader>", "L"], "commands": ["update.showCurrentReleaseNotes"]},
      {"before": ["<leader>", "K"], "commands": ["editor.action.showHover"]},
      {"before": ["<leader>", "f", "n"], "commands": ["workbench.action.files.newUntitledFile"]},
      {"before": ["<leader>", "?"], "commands": ["workbench.action.openGlobalKeybindings"]},
      {"before": ["<leader>", "."], "commands": ["workbench.action.files.newUntitledFile"]},
      {"before": ["<leader>", "n"], "commands": ["notifications.showList"]},
      {"before": ["<leader>", "u", "n"], "commands": ["notifications.clearAll"]},
      {"before": ["<C-space>"], "commands": ["editor.action.smartSelect.expand"]},
      {"before": ["g", "x"], "commands": ["editor.action.openLink"]},
      {"before": ["<leader>", "-"], "commands": ["workbench.action.splitEditorDown"]},
      {"before": ["<leader>", "|"], "commands": ["workbench.action.splitEditorRight"]},
      // ----- Buffers -----
      {"before": ["H"], "commands": ["workbench.action.previousEditor"]},
      {"before": ["L"], "commands": ["workbench.action.nextEditor"]},
      {"before": ["[", "b"], "commands": ["workbench.action.previousEditor"]},
      {"before": ["]", "b"], "commands": ["workbench.action.nextEditor"]},
      {"before": ["[", "B"], "commands": ["workbench.action.moveEditorLeftInGroup"]},
      {"before": ["]", "B"], "commands": ["workbench.action.moveEditorRightInGroup"]},
      {"before": ["<leader>", "b", "b"], "commands": ["workbench.action.openPreviousRecentlyUsedEditorInGroup"]},
      {"before": ["<leader>", "`"], "commands": ["workbench.action.openPreviousRecentlyUsedEditorInGroup"]},
      {"before": ["<leader>", "b", "d"], "commands": ["workbench.action.closeActiveEditor"]},
      {"before": ["<leader>", "b", "D"], "commands": ["workbench.action.closeEditorsAndGroup"]},
      {"before": ["<leader>", "b", "o"], "commands": ["workbench.action.closeOtherEditors"]},
      {"before": ["<leader>", "b", "i"], "commands": ["workbench.action.closeUnmodifiedEditors"]},
      {"before": ["<leader>", "b", "p"], "commands": ["workbench.action.pinEditor"]},
      {"before": ["<leader>", "b", "P"], "commands": ["workbench.action.closeUnpinnedEditors"]},
      {"before": ["<leader>", "b", "r"], "commands": ["workbench.action.closeEditorsToTheRight"]},
      {"before": ["<leader>", "b", "l"], "commands": ["workbench.action.closeEditorsToTheLeft"]},
      {"before": ["<leader>", "b", "j"], "commands": ["workbench.action.showAllEditors"]},
      {"before": ["<leader>", ","], "commands": ["workbench.action.showAllEditors"]},
      // ----- Windows -----
      {"before": ["<C-h>"], "commands": ["workbench.action.navigateLeft"]},
      {"before": ["<C-j>"], "commands": ["workbench.action.navigateDown"]},
      {"before": ["<C-k>"], "commands": ["workbench.action.navigateUp"]},
      {"before": ["<C-l>"], "commands": ["workbench.action.navigateRight"]},
      {"before": ["<leader>", "w", "w"], "commands": ["workbench.action.focusNextGroup"]},
      {"before": ["<leader>", "w", "h"], "commands": ["workbench.action.focusLeftGroup"]},
      {"before": ["<leader>", "w", "j"], "commands": ["workbench.action.focusBelowGroup"]},
      {"before": ["<leader>", "w", "k"], "commands": ["workbench.action.focusAboveGroup"]},
      {"before": ["<leader>", "w", "l"], "commands": ["workbench.action.focusRightGroup"]},
      {"before": ["<leader>", "w", "d"], "commands": ["workbench.action.closeEditorsInGroup"]},
      {"before": ["<leader>", "w", "c"], "commands": ["workbench.action.closeEditorsInGroup"]},
      {"before": ["<leader>", "w", "s"], "commands": ["workbench.action.splitEditorDown"]},
      {"before": ["<leader>", "w", "v"], "commands": ["workbench.action.splitEditorRight"]},
      {"before": ["<leader>", "w", "-"], "commands": ["workbench.action.splitEditorDown"]},
      {"before": ["<leader>", "w", "|"], "commands": ["workbench.action.splitEditorRight"]},
      {"before": ["<leader>", "w", "="], "commands": ["workbench.action.evenEditorWidths"]},
      {"before": ["<leader>", "w", "m"], "commands": ["workbench.action.toggleMaximizeEditorGroup"]},
      {"before": ["<leader>", "u", "Z"], "commands": ["workbench.action.toggleMaximizeEditorGroup"]},
      {"before": ["<leader>", "u", "z"], "commands": ["workbench.action.toggleZenMode"]},
      // ----- Tabs (editor groups) -----
      {"before": ["<leader>", "<tab>", "<tab>"], "commands": ["workbench.action.newGroupRight"]},
      {"before": ["<leader>", "<tab>", "]"], "commands": ["workbench.action.focusNextGroup"]},
      {"before": ["<leader>", "<tab>", "["], "commands": ["workbench.action.focusPreviousGroup"]},
      {"before": ["<leader>", "<tab>", "f"], "commands": ["workbench.action.focusFirstEditorGroup"]},
      {"before": ["<leader>", "<tab>", "l"], "commands": ["workbench.action.focusLastEditorGroup"]},
      {"before": ["<leader>", "<tab>", "d"], "commands": ["workbench.action.closeEditorsInGroup"]},
      // ----- Find / files -----
      {"before": ["<leader>", "<space>"], "commands": ["workbench.action.quickOpen"]},
      {"before": ["<leader>", "/"], "commands": ["workbench.action.findInFiles"]},
      {"before": ["<leader>", ":"], "commands": ["workbench.action.showCommands"]},
      {"before": ["<leader>", "f", "b"], "commands": ["workbench.action.showAllEditors"]},
      {"before": ["<leader>", "f", "B"], "commands": ["workbench.action.showAllEditors"]},
      {"before": ["<leader>", "f", "c"], "commands": ["workbench.action.openSettingsJson"]},
      {"before": ["<leader>", "f", "f"], "commands": ["workbench.action.quickOpen"]},
      {"before": ["<leader>", "f", "F"], "commands": ["workbench.action.quickOpen"]},
      {"before": ["<leader>", "f", "g"], "commands": ["workbench.action.quickOpen"]},
      {"before": ["<leader>", "f", "r"], "commands": ["workbench.action.openRecent"]},
      {"before": ["<leader>", "f", "R"], "commands": ["workbench.action.openRecent"]},
      {"before": ["<leader>", "f", "p"], "commands": ["workbench.action.openRecent"]},
      {"before": ["<leader>", "e"], "commands": ["workbench.view.explorer"]},
      {"before": ["<leader>", "E"], "commands": ["workbench.files.action.showActiveFileInExplorer"]},
      {"before": ["<leader>", "f", "e"], "commands": ["workbench.view.explorer"]},
      {"before": ["<leader>", "f", "E"], "commands": ["workbench.files.action.showActiveFileInExplorer"]},
      {"before": ["<leader>", "f", "t"], "commands": ["workbench.action.terminal.toggleTerminal"]},
      {"before": ["<leader>", "f", "T"], "commands": ["workbench.action.terminal.toggleTerminal"]},
      // ----- Search -----
      {"before": ["<leader>", "s", "/"], "commands": ["workbench.action.findInFiles"]},
      {"before": ["<leader>", "s", "b"], "commands": ["actions.find"]},
      {"before": ["<leader>", "s", "B"], "commands": ["workbench.action.findInFiles"]},
      {"before": ["<leader>", "s", "c"], "commands": ["workbench.action.showCommands"]},
      {"before": ["<leader>", "s", "C"], "commands": ["workbench.action.showCommands"]},
      {"before": ["<leader>", "s", "d"], "commands": ["workbench.actions.view.problems"]},
      {"before": ["<leader>", "s", "D"], "commands": ["workbench.actions.view.problems"]},
      {"before": ["<leader>", "s", "g"], "commands": ["workbench.action.findInFiles"]},
      {"before": ["<leader>", "s", "G"], "commands": ["workbench.action.findInFiles"]},
      {"before": ["<leader>", "s", "h"], "commands": ["workbench.action.openDocumentationUrl"]},
      {"before": ["<leader>", "s", "k"], "commands": ["workbench.action.openGlobalKeybindings"]},
      {"before": ["<leader>", "s", "R"], "commands": ["workbench.view.search"]},
      {"before": ["<leader>", "s", "s"], "commands": ["workbench.action.gotoSymbol"]},
      {"before": ["<leader>", "s", "S"], "commands": ["workbench.action.showAllSymbols"]},
      {"before": ["<leader>", "s", "r"], "commands": ["workbench.action.replaceInFiles"]},
      {"before": ["<leader>", "s", "w"], "commands": ["workbench.action.findInFiles"]},
      {"before": ["<leader>", "s", "W"], "commands": ["workbench.action.findInFiles"]},
      {"before": ["<leader>", "s", "t"], "commands": [{"command": "workbench.action.findInFiles", "args": {"query": "TODO|FIXME|HACK|BUG|WARN|PERF|NOTE", "isRegex": true, "triggerSearch": true}}]},
      {"before": ["<leader>", "s", "T"], "commands": [{"command": "workbench.action.findInFiles", "args": {"query": "TODO|FIXME|HACK|BUG|WARN|PERF|NOTE", "isRegex": true, "triggerSearch": true}}]},
      {"before": ["<leader>", "s", "n", "l"], "commands": ["notifications.showList"]},
      {"before": ["<leader>", "s", "n", "h"], "commands": ["notifications.showList"]},
      {"before": ["<leader>", "s", "n", "a"], "commands": ["notifications.showList"]},
      {"before": ["<leader>", "s", "n", "d"], "commands": ["notifications.clearAll"]},
      // ----- Code / LSP -----
      {"before": ["g", "d"], "commands": ["editor.action.revealDefinition"]},
      {"before": ["g", "r"], "commands": ["editor.action.goToReferences"]},
      {"before": ["g", "I"], "commands": ["editor.action.goToImplementation"]},
      {"before": ["g", "y"], "commands": ["editor.action.goToTypeDefinition"]},
      {"before": ["g", "D"], "commands": ["editor.action.revealDeclaration"]},
      {"before": ["K"], "commands": ["editor.action.showHover"]},
      {"before": ["g", "K"], "commands": ["editor.action.triggerParameterHints"]},
      {"before": ["<leader>", "c", "l"], "commands": ["workbench.action.output.toggleOutput"]},
      {"before": ["<leader>", "c", "a"], "commands": ["editor.action.quickFix"]},
      {"before": ["<leader>", "c", "c"], "commands": ["codelens.showLensesInCurrentLine"]},
      {"before": ["<leader>", "c", "C"], "commands": ["codelens.showLensesInCurrentLine"]},
      {"before": ["<leader>", "c", "R"], "commands": ["workbench.files.action.showActiveFileInExplorer", "renameFile"]},
      {"before": ["<leader>", "c", "r"], "commands": ["editor.action.rename"]},
      {"before": ["<leader>", "c", "A"], "commands": ["editor.action.sourceAction"]},
      {"before": ["<leader>", "c", "o"], "commands": ["editor.action.organizeImports"]},
      {"before": ["<leader>", "c", "f"], "commands": ["editor.action.formatDocument"]},
      {"before": ["<leader>", "c", "F"], "commands": ["editor.action.formatDocument"]},
      {"before": ["<leader>", "c", "d"], "commands": ["editor.action.showHover"]},
      {"before": ["<leader>", "c", "m"], "commands": ["workbench.view.extensions"]},
      {"before": ["<leader>", "c", "s"], "commands": ["outline.focus"]},
      {"before": ["<leader>", "c", "S"], "commands": ["editor.action.referenceSearch.trigger"]},
      {"before": ["]", "]"], "commands": ["editor.action.wordHighlight.next"]},
      {"before": ["[", "["], "commands": ["editor.action.wordHighlight.prev"]},
      {"before": ["<A-n>"], "commands": ["editor.action.wordHighlight.next"]},
      {"before": ["<A-p>"], "commands": ["editor.action.wordHighlight.prev"]},
      {"before": ["g", "a", "i"], "commands": ["editor.showIncomingCalls"]},
      {"before": ["g", "a", "o"], "commands": ["editor.showOutgoingCalls"]},
      // ----- Diagnostics / quickfix -----
      {"before": ["]", "d"], "commands": ["editor.action.marker.next"]},
      {"before": ["[", "d"], "commands": ["editor.action.marker.prev"]},
      {"before": ["]", "e"], "commands": ["editor.action.marker.next"]},
      {"before": ["[", "e"], "commands": ["editor.action.marker.prev"]},
      {"before": ["]", "w"], "commands": ["editor.action.marker.next"]},
      {"before": ["[", "w"], "commands": ["editor.action.marker.prev"]},
      {"before": ["]", "q"], "commands": ["search.action.focusNextSearchResult"]},
      {"before": ["[", "q"], "commands": ["search.action.focusPreviousSearchResult"]},
      {"before": ["<leader>", "x", "x"], "commands": ["workbench.actions.view.problems"]},
      {"before": ["<leader>", "x", "X"], "commands": ["workbench.actions.view.problems"]},
      {"before": ["<leader>", "x", "L"], "commands": ["workbench.actions.view.problems"]},
      {"before": ["<leader>", "x", "l"], "commands": ["workbench.actions.view.problems"]},
      {"before": ["<leader>", "x", "Q"], "commands": ["workbench.actions.view.problems"]},
      {"before": ["<leader>", "x", "q"], "commands": ["workbench.actions.view.problems"]},
      {"before": ["<leader>", "x", "t"], "commands": [{"command": "workbench.action.findInFiles", "args": {"query": "TODO|FIXME|HACK|BUG|WARN|PERF|NOTE", "isRegex": true, "triggerSearch": true}}]},
      {"before": ["<leader>", "x", "T"], "commands": [{"command": "workbench.action.findInFiles", "args": {"query": "TODO|FIXME|HACK|BUG|WARN|PERF|NOTE", "isRegex": true, "triggerSearch": true}}]},
      // ----- Git -----
      {"before": ["<leader>", "g", "g"], "commands": ["workbench.view.scm"]},
      {"before": ["<leader>", "g", "G"], "commands": ["workbench.view.scm"]},
      {"before": ["<leader>", "g", "s"], "commands": ["workbench.view.scm"]},
      {"before": ["<leader>", "g", "S"], "commands": ["gitlens.showQuickStashList"]},
      {"before": ["<leader>", "g", "L"], "commands": ["gitlens.showQuickRepoHistory"]},
      {"before": ["<leader>", "g", "l"], "commands": ["gitlens.showQuickRepoHistory"]},
      {"before": ["<leader>", "g", "b"], "commands": ["gitlens.toggleLineBlame"]},
      {"before": ["<leader>", "g", "f"], "commands": ["gitlens.showQuickFileHistory"]},
      {"before": ["<leader>", "g", "B"], "commands": ["gitlens.openFileOnRemote"]},
      {"before": ["<leader>", "g", "Y"], "commands": ["gitlens.copyRemoteFileUrlToClipboard"]},
      {"before": ["<leader>", "g", "d"], "commands": ["git.openChange"]},
      {"before": ["<leader>", "g", "D"], "commands": ["gitlens.diffWithPrevious"]},
      {"before": ["<leader>", "g", "i"], "commands": ["workbench.view.scm"]},
      {"before": ["<leader>", "g", "p"], "commands": ["workbench.view.scm"]},
      {"before": ["]", "h"], "commands": ["workbench.action.editor.nextChange"]},
      {"before": ["[", "h"], "commands": ["workbench.action.editor.previousChange"]},
      {"before": ["<leader>", "g", "h", "s"], "commands": ["git.stageSelectedRanges"]},
      {"before": ["<leader>", "g", "h", "r"], "commands": ["git.revertSelectedRanges"]},
      {"before": ["<leader>", "g", "h", "S"], "commands": ["git.stage"]},
      {"before": ["<leader>", "g", "h", "u"], "commands": ["git.unstageSelectedRanges"]},
      {"before": ["<leader>", "g", "h", "R"], "commands": ["git.clean"]},
      {"before": ["<leader>", "g", "h", "p"], "commands": ["editor.action.dirtydiff.next"]},
      {"before": ["<leader>", "g", "h", "b"], "commands": ["gitlens.toggleLineBlame"]},
      {"before": ["<leader>", "g", "h", "B"], "commands": ["gitlens.toggleFileBlame"]},
      {"before": ["<leader>", "g", "h", "d"], "commands": ["git.openChange"]},
      {"before": ["<leader>", "g", "h", "D"], "commands": ["gitlens.diffWithPrevious"]},
      // ----- UI toggles -----
      {"before": ["<leader>", "u", "r"], "commands": [":nohl"]},
      {"before": ["<leader>", "u", "w"], "commands": ["editor.action.toggleWordWrap"]},
      {"before": ["<leader>", "u", "b"], "commands": ["workbench.action.toggleLightDarkThemes"]},
      {"before": ["<leader>", "u", "C"], "commands": ["workbench.action.selectTheme"]},
      {"before": ["<leader>", "u", "i"], "commands": ["editor.action.inspectTMScopes"]},
      {"before": ["<leader>", "u", "I"], "commands": ["editor.action.inspectTMScopes"]},
      {"before": ["<leader>", "u", "g"], "commands": ["editor.action.toggleRenderWhitespace"]},
      // ----- Quit / session -----
      {"before": ["<leader>", "q", "q"], "commands": ["workbench.action.closeWindow"]},
      {"before": ["<leader>", "q", "s"], "commands": ["workbench.action.openRecent"]},
      {"before": ["<leader>", "q", "S"], "commands": ["workbench.action.openRecent"]},
      {"before": ["<leader>", "q", "l"], "commands": ["workbench.action.openRecent"]},
