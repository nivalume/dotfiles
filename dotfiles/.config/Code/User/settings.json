      {"before": ["<leader>", "t", "T"], "commands": ["testing.runAll"]},
      {"before": ["<leader>", "t", "r"], "commands": ["testing.runAtCursor"]},
      {"before": ["<leader>", "t", "l"], "commands": ["testing.reRunLastRun"]},
      {"before": ["<leader>", "t", "s"], "commands": ["workbench.view.testing.focus"]},
      {"before": ["<leader>", "t", "o"], "commands": ["testing.showMostRecentOutput"]},
      {"before": ["<leader>", "t", "O"], "commands": ["testing.showMostRecentOutput"]},
      {"before": ["<leader>", "t", "S"], "commands": ["testing.cancelRun"]},
      {"before": ["<leader>", "t", "d"], "commands": ["testing.debugAtCursor"]},
